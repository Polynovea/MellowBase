# Defaults for the "tunnel" profile of docker/compose.yaml. Compose reads polynovea.env after this file,
# so a value set there wins.
#
# The address the owner opens through the SSH tunnel (ssh -L 3000:localhost:3000 you@server). The setup
# wizard's passkey and the CMS's sign-in belong to this exact address: open http://localhost:3000, not
# http://127.0.0.1:3000 (a different address to the browser). Tunnel to another local port or name?
# Set POLYNOVEA_PUBLIC_URL in polynovea.env to the address you open.
POLYNOVEA_PUBLIC_URL=http://localhost:3000

# Polynovea CMS on Azure: the same resources as deploy/azure/main.bicep, for teams that use OpenTofu.
# State holds the generated database password, so the root module MUST enable state encryption
# (see deploy/opentofu/examples/azure). The provider must set storage_use_azuread = true, because the
# storage account accepts Microsoft Entra ID only (no shared keys).

locals {
  managed        = var.database_mode == "managed"
  tags           = merge({ "polynovea:stack" = var.name }, var.tags)
  suffix         = substr(sha1(data.azurerm_resource_group.main.id), 0, 10)
  vm_subnet_cidr = "10.30.0.0/24"
  db_subnet_cidr = "10.30.1.0/24"
  admin_user     = "polynovea_admin"
  database_name  = "polynovea"
  container_name = "polynovea"
  secret_name    = "polynovea-database-admin"

  # Non-secret values only, with the release package's keys. The release package sets HOSTNAME, PORT,
  # POLYNOVEA_TRUSTED_PROXIES and POLYNOVEA_CONFIG_DIR.
  settings = join("\n", compact([
    "# Written by the Polynovea OpenTofu module. Non-secret values only.",
    local.managed ? "POLYNOVEA_DB_SECRET_REF=${azurerm_key_vault_secret.database[0].versionless_id}" : "",
    "POLYNOVEA_BACKUP_ACCOUNT=${azurerm_storage_account.main.name}",
    "POLYNOVEA_BACKUP_CONTAINER=${local.container_name}",
    var.domain != "" ? "POLYNOVEA_DOMAIN=${var.domain}" : "",
    var.acme_email != "" ? "POLYNOVEA_ACME_EMAIL=${var.acme_email}" : "",
    var.container_image != "" ? "POLYNOVEA_IMAGE_REF=${var.container_image}" : "",
    var.caddy_image != "" ? "POLYNOVEA_CADDY_IMAGE_REF=${var.caddy_image}" : "",
  ]))

  # vm-bootstrap.sh is the release package's first-boot script (generated by
  # deploy/scripts/sync-vm-bootstrap.mjs). It runs as its own systemd unit, not inside cloud-init,
  # because it waits for cloud-init to finish.
  cloud_init = join("\n", [
    "#cloud-config",
    "write_files:",
    "  - path: /etc/polynovea/polynovea.env",
    "    permissions: \"0640\"",
    "    encoding: b64",
    "    content: ${base64encode("${local.settings}\n")}",
    "  - path: /usr/local/sbin/polynovea-bootstrap",
    "    permissions: \"0750\"",
    "    encoding: b64",
    "    content: ${filebase64("${path.module}/vm-bootstrap.sh")}",
    "runcmd:",
    "  - [systemd-run, --unit=polynovea-bootstrap, \"--description=Polynovea first boot\", /bin/sh, /usr/local/sbin/polynovea-bootstrap, azure]",
  ])
}

data "azurerm_resource_group" "main" {
  name = var.resource_group_name
}

data "azurerm_client_config" "current" {}

# ------------------------------------------------------------------ network

resource "azurerm_network_security_group" "vm" {
  name                = "${var.name}-vm-nsg"
  location            = var.location
  resource_group_name = var.resource_group_name
  tags                = local.tags

  # Without a domain nothing answers on 80/443 (the CMS listens on 127.0.0.1 only), so they stay closed.
  dynamic "security_rule" {
    for_each = var.domain == "" ? {} : { "allow-http" = { priority = 100, port = "80" }, "allow-https" = { priority = 110, port = "443" } }
    content {
      name                       = security_rule.key
      priority                   = security_rule.value.priority
      direction                  = "Inbound"
      access                     = "Allow"
      protocol                   = "Tcp"
      source_address_prefix      = "Internet"
      source_port_range          = "*"
      destination_address_prefix = local.vm_subnet_cidr
      destination_port_range     = security_rule.value.port
    }
  }

  dynamic "security_rule" {
    for_each = var.admin_cidr == "" ? [] : [var.admin_cidr]
    content {
      name                       = "allow-ssh-from-owner"
      priority                   = 120
      direction                  = "Inbound"
      access                     = "Allow"
      protocol                   = "Tcp"
      source_address_prefix      = security_rule.value
      source_port_range          = "*"
      destination_address_prefix = local.vm_subnet_cidr
      destination_port_range     = "22"
    }
  }

  security_rule {
    name                       = "deny-other-inbound"
    priority                   = 4000
    direction                  = "Inbound"
    access                     = "Deny"
    protocol                   = "*"
    source_address_prefix      = "*"
    source_port_range          = "*"
    destination_address_prefix = "*"
    destination_port_range     = "*"
  }

  dynamic "security_rule" {
    for_each = local.managed ? [1] : []
    content {
      name                       = "allow-postgres-to-database"
      priority                   = 100
      direction                  = "Outbound"
      access                     = "Allow"
      protocol                   = "Tcp"
      source_address_prefix      = local.vm_subnet_cidr
      source_port_range          = "*"
      destination_address_prefix = local.db_subnet_cidr
      destination_port_range     = "5432"
    }
  }

  security_rule {
    name                       = "deny-other-vnet-outbound"
    priority                   = 4000
    direction                  = "Outbound"
    access                     = "Deny"
    protocol                   = "*"
    source_address_prefix      = "*"
    source_port_range          = "*"
    destination_address_prefix = "VirtualNetwork"
    destination_port_range     = "*"
  }
}

resource "azurerm_network_security_group" "database" {
  count               = local.managed ? 1 : 0
  name                = "${var.name}-db-nsg"
  location            = var.location
  resource_group_name = var.resource_group_name
  tags                = local.tags

  security_rule {
    name                       = "allow-postgres-from-vm"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_address_prefix      = local.vm_subnet_cidr
    source_port_range          = "*"
    destination_address_prefix = local.db_subnet_cidr
    destination_port_range     = "5432"
  }

  security_rule {
    name                       = "deny-other-inbound"
    priority                   = 4000
    direction                  = "Inbound"
    access                     = "Deny"
    protocol                   = "*"
    source_address_prefix      = "*"
    source_port_range          = "*"
    destination_address_prefix = "*"
    destination_port_range     = "*"
  }
}

resource "azurerm_virtual_network" "main" {
  name                = "${var.name}-vnet"
  location            = var.location
  resource_group_name = var.resource_group_name
  address_space       = ["10.30.0.0/16"]
  tags                = local.tags
}

resource "azurerm_subnet" "vm" {
  name                 = "vm"
  resource_group_name  = var.resource_group_name
  virtual_network_name = azurerm_virtual_network.main.name
  address_prefixes     = [local.vm_subnet_cidr]
  service_endpoints    = ["Microsoft.KeyVault", "Microsoft.Storage"]
}

resource "azurerm_subnet_network_security_group_association" "vm" {
  subnet_id                 = azurerm_subnet.vm.id
  network_security_group_id = azurerm_network_security_group.vm.id
}

resource "azurerm_subnet" "database" {
  count                = local.managed ? 1 : 0
  name                 = "database"
  resource_group_name  = var.resource_group_name
  virtual_network_name = azurerm_virtual_network.main.name
  address_prefixes     = [local.db_subnet_cidr]

  delegation {
    name = "postgres"
    service_delegation {
      name    = "Microsoft.DBforPostgreSQL/flexibleServers"
      actions = ["Microsoft.Network/virtualNetworks/subnets/join/action"]
    }
  }
}

resource "azurerm_subnet_network_security_group_association" "database" {
  count                     = local.managed ? 1 : 0
  subnet_id                 = azurerm_subnet.database[0].id
  network_security_group_id = azurerm_network_security_group.database[0].id
}

# ------------------------------------------------------------------ database ("Created for you")

resource "azurerm_private_dns_zone" "database" {
  count               = local.managed ? 1 : 0
  name                = "${var.name}-${local.suffix}.private.postgres.database.azure.com"
  resource_group_name = var.resource_group_name
  tags                = local.tags
}

resource "azurerm_private_dns_zone_virtual_network_link" "database" {
  count                 = local.managed ? 1 : 0
  name                  = "polynovea-vnet"
  resource_group_name   = var.resource_group_name
  private_dns_zone_name = azurerm_private_dns_zone.database[0].name
  virtual_network_id    = azurerm_virtual_network.main.id
  registration_enabled  = false
}

# Upper, lower and digits (three of Flexible Server's four classes); letters and digits only, so it
# never needs escaping. Kept only in Key Vault and the (encrypted) state.
resource "random_password" "database_admin" {
  count       = local.managed ? 1 : 0
  length      = 40
  special     = false
  min_upper   = 2
  min_lower   = 2
  min_numeric = 2
}

resource "azurerm_postgresql_flexible_server" "main" {
  count                         = local.managed ? 1 : 0
  name                          = "${var.name}-db-${local.suffix}"
  location                      = var.location
  resource_group_name           = var.resource_group_name
  version                       = "16"
  sku_name                      = var.database_sku
  storage_mb                    = var.database_storage_mb
  auto_grow_enabled             = true
  backup_retention_days         = 7
  geo_redundant_backup_enabled  = false
  public_network_access_enabled = false
  delegated_subnet_id           = azurerm_subnet.database[0].id
  private_dns_zone_id           = azurerm_private_dns_zone.database[0].id
  administrator_login           = local.admin_user
  administrator_password        = random_password.database_admin[0].result
  tags                          = local.tags

  authentication {
    password_auth_enabled         = true
    active_directory_auth_enabled = false
  }

  depends_on = [azurerm_private_dns_zone_virtual_network_link.database]

  lifecycle {
    prevent_destroy = true
    ignore_changes  = [zone]
  }
}

resource "azurerm_postgresql_flexible_server_configuration" "require_tls" {
  count     = local.managed ? 1 : 0
  name      = "require_secure_transport"
  server_id = azurerm_postgresql_flexible_server.main[0].id
  value     = "on"
}

resource "azurerm_postgresql_flexible_server_database" "main" {
  count     = local.managed ? 1 : 0
  name      = local.database_name
  server_id = azurerm_postgresql_flexible_server.main[0].id
  charset   = "UTF8"
  collation = "en_US.utf8"

  lifecycle {
    prevent_destroy = true
  }
}

resource "azurerm_management_lock" "database" {
  count      = local.managed ? 1 : 0
  name       = "polynovea-keep-database"
  scope      = azurerm_postgresql_flexible_server.main[0].id
  lock_level = "CanNotDelete"
  notes      = "Holds the Polynovea CMS content. Remove this lock deliberately before deleting the database."
}

resource "azurerm_key_vault" "main" {
  count                         = local.managed ? 1 : 0
  name                          = "pnv-${local.suffix}"
  location                      = var.location
  resource_group_name           = var.resource_group_name
  tenant_id                     = data.azurerm_client_config.current.tenant_id
  sku_name                      = "standard"
  rbac_authorization_enabled    = true
  purge_protection_enabled      = true
  soft_delete_retention_days    = 90
  public_network_access_enabled = true
  tags                          = local.tags

  network_acls {
    default_action             = "Deny"
    bypass                     = "AzureServices"
    virtual_network_subnet_ids = [azurerm_subnet.vm.id]
    ip_rules                   = var.operator_ip_ranges
  }
}

# Lets whoever runs OpenTofu write the secret (Key Vault's data plane). Nothing else.
resource "azurerm_role_assignment" "operator_writes_secret" {
  count                = local.managed ? 1 : 0
  scope                = azurerm_key_vault.main[0].id
  role_definition_name = "Key Vault Secrets Officer"
  principal_id         = data.azurerm_client_config.current.object_id
}

# The shape the setup wizard reads (lib/setup/database/createdForYou.ts).
resource "azurerm_key_vault_secret" "database" {
  count        = local.managed ? 1 : 0
  name         = local.secret_name
  key_vault_id = azurerm_key_vault.main[0].id
  content_type = "application/json"
  value = jsonencode({
    engine   = "postgres"
    host     = azurerm_postgresql_flexible_server.main[0].fqdn
    port     = 5432
    username = local.admin_user
    password = random_password.database_admin[0].result
    dbname   = local.database_name
  })

  depends_on = [azurerm_role_assignment.operator_writes_secret, azurerm_postgresql_flexible_server_database.main]
}

# ------------------------------------------------------------------ storage: one container

resource "azurerm_storage_account" "main" {
  name                              = "${var.name}${local.suffix}"
  location                          = var.location
  resource_group_name               = var.resource_group_name
  account_kind                      = "StorageV2"
  account_tier                      = "Standard"
  account_replication_type          = "LRS"
  access_tier                       = "Hot"
  min_tls_version                   = "TLS1_2"
  https_traffic_only_enabled        = true
  allow_nested_items_to_be_public   = false
  shared_access_key_enabled         = false
  default_to_oauth_authentication   = true
  cross_tenant_replication_enabled  = false
  infrastructure_encryption_enabled = true
  public_network_access_enabled     = true
  tags                              = local.tags

  network_rules {
    default_action             = "Deny"
    bypass                     = ["AzureServices"]
    virtual_network_subnet_ids = [azurerm_subnet.vm.id]
    ip_rules                   = var.operator_ip_ranges
  }

  blob_properties {
    delete_retention_policy {
      days = 14
    }
    container_delete_retention_policy {
      days = 14
    }
  }

  lifecycle {
    prevent_destroy = true
  }
}

resource "azurerm_storage_container" "main" {
  name                  = local.container_name
  storage_account_id    = azurerm_storage_account.main.id
  container_access_type = "private"
}

resource "azurerm_management_lock" "storage" {
  name       = "polynovea-keep-storage"
  scope      = azurerm_storage_account.main.id
  lock_level = "CanNotDelete"
  notes      = "Holds Polynovea backups and files. Remove this lock deliberately before deleting the storage account."
}

# ------------------------------------------------------------------ the VM

resource "azurerm_public_ip" "main" {
  name                = "${var.name}-ip"
  location            = var.location
  resource_group_name = var.resource_group_name
  allocation_method   = "Static"
  sku                 = "Standard"
  domain_name_label   = "${var.name}-${local.suffix}"
  tags                = local.tags
}

resource "azurerm_network_interface" "main" {
  name                = "${var.name}-nic"
  location            = var.location
  resource_group_name = var.resource_group_name
  tags                = local.tags

  ip_configuration {
    name                          = "primary"
    subnet_id                     = azurerm_subnet.vm.id
    private_ip_address_allocation = "Dynamic"
    public_ip_address_id          = azurerm_public_ip.main.id
  }
}

resource "azurerm_managed_disk" "data" {
  name                          = "${var.name}-data"
  location                      = var.location
  resource_group_name           = var.resource_group_name
  storage_account_type          = "StandardSSD_LRS"
  create_option                 = "Empty"
  disk_size_gb                  = var.data_disk_gb
  public_network_access_enabled = false
  network_access_policy         = "DenyAll"
  tags                          = local.tags

  # Holds settings, uploads and (on-this-server) the database itself.
  lifecycle {
    prevent_destroy = true
  }
}

resource "azurerm_linux_virtual_machine" "main" {
  name                            = "${var.name}-vm"
  computer_name                   = "polynovea"
  location                        = var.location
  resource_group_name             = var.resource_group_name
  size                            = var.vm_size
  admin_username                  = "polynovea"
  disable_password_authentication = true
  network_interface_ids           = [azurerm_network_interface.main.id]
  custom_data                     = base64encode(local.cloud_init)
  allow_extension_operations      = false
  provision_vm_agent              = true
  patch_mode                      = "ImageDefault"
  secure_boot_enabled             = var.architecture == "x64"
  vtpm_enabled                    = var.architecture == "x64"
  source_image_id                 = var.custom_image_id == "" ? null : var.custom_image_id
  tags                            = local.tags

  identity {
    type = "SystemAssigned"
  }

  admin_ssh_key {
    username   = "polynovea"
    public_key = var.admin_ssh_public_key
  }

  os_disk {
    name                 = "${var.name}-os"
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
    disk_size_gb         = 30
  }

  dynamic "source_image_reference" {
    for_each = var.custom_image_id == "" ? [1] : []
    content {
      publisher = "Canonical"
      offer     = "ubuntu-24_04-lts"
      sku       = var.architecture == "arm64" ? "server-arm64" : "server"
      version   = "latest"
    }
  }

  # Azure-managed boot diagnostics: the serial console helps when the VM will not boot.
  boot_diagnostics {}
}

resource "azurerm_virtual_machine_data_disk_attachment" "data" {
  managed_disk_id    = azurerm_managed_disk.data.id
  virtual_machine_id = azurerm_linux_virtual_machine.main.id
  lun                = 0
  caching            = "ReadWrite"
}

# ------------------------------------------------------------------ identity: one secret, one container

resource "azurerm_role_assignment" "vm_reads_secret" {
  count                = local.managed ? 1 : 0
  scope                = azurerm_key_vault_secret.database[0].resource_versionless_id
  role_definition_name = "Key Vault Secrets User"
  principal_id         = azurerm_linux_virtual_machine.main.identity[0].principal_id
  principal_type       = "ServicePrincipal"
  description          = "The Polynovea VM reads this one secret: the database admin login, used once by the setup wizard."
}

resource "azurerm_role_assignment" "vm_uses_container" {
  scope                = azurerm_storage_container.main.id
  role_definition_name = "Storage Blob Data Contributor"
  principal_id         = azurerm_linux_virtual_machine.main.identity[0].principal_id
  principal_type       = "ServicePrincipal"
  description          = "The Polynovea VM uses this one container: backups and files."
}

# ------------------------------------------------------------------ budget alert

resource "azurerm_consumption_budget_resource_group" "monthly" {
  name              = "polynovea-${local.suffix}"
  resource_group_id = data.azurerm_resource_group.main.id
  amount            = var.budget_monthly_amount
  time_grain        = "Monthly"

  time_period {
    start_date = var.budget_start_date
  }

  notification {
    enabled        = true
    operator       = "GreaterThan"
    threshold      = 80
    threshold_type = "Actual"
    contact_emails = [var.budget_email]
  }

  notification {
    enabled        = true
    operator       = "GreaterThan"
    threshold      = 100
    threshold_type = "Forecasted"
    contact_emails = [var.budget_email]
  }
}

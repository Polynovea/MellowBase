# Polynovea CMS OSS V1 — environment template
# Copy to .env.local for local development. Never commit real secrets.

# Required application runtime (Supabase/PostgREST-compatible profile)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required for migrations and the persistent delivery worker
DATABASE_URL=postgresql://user:password@host:5432/postgres

# The CMS reads and writes its data directly on PostgreSQL. The runtime connects as a role that can
# read and write rows and execute functions but cannot run DDL (polynovea_app). Falls back to
# DATABASE_URL when unset.
POLYNOVEA_DATABASE_URL=
# Identity provider: supabase (GoTrue, the default and the rollback path) or builtin (built-in auth on
# this PostgreSQL database). Both values must match; the browser bundle reads the NEXT_PUBLIC_ one at
# build time, so rebuild after changing it.
AUTH_PROVIDER=supabase
NEXT_PUBLIC_AUTH_PROVIDER=supabase
# Built-in auth only. The secret signs session cookies: 32+ random characters, e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`. Never commit it.
POLYNOVEA_AUTH_SECRET=
# The public https:// URL of the CMS. Cookies are __Host- prefixed and Secure, and passkeys are bound
# to this origin.
POLYNOVEA_PUBLIC_URL=
# Built-in auth only. Addresses or CIDR ranges of the reverse proxies in front of the app, comma
# separated. Required in production: X-Forwarded-For is read only through these, so clients cannot
# pick their own rate-limit bucket. The app port itself must not be reachable except through them.
POLYNOVEA_TRUSTED_PROXIES=
# Optional larger breached-password list (one per line), on top of the bundled one. Set
# POLYNOVEA_HIBP_DISABLED=true to skip the Have I Been Pwned range API on installs without internet.
POLYNOVEA_BREACHED_PASSWORDS_FILE=
POLYNOVEA_HIBP_DISABLED=
# Optional pool tuning (defaults: 10 connections, 15 s statement timeout, 5 s connect timeout).
POLYNOVEA_DB_POOL_MAX=
POLYNOVEA_DB_STATEMENT_TIMEOUT_MS=
POLYNOVEA_DB_CONNECT_TIMEOUT_MS=

# PostgreSQL TLS. Remote databases always use TLS with full certificate verification.
# Supabase and AWS RDS sign with their own CA: download it (Supabase: Project Settings >
# Database > SSL Configuration) and set ONE of these. Use \n for line breaks in DATABASE_CA_CERT.
# Use ?sslmode=disable in DATABASE_URL only for a database on a private network without TLS.
DATABASE_CA_CERT=
DATABASE_CA_CERT_FILE=

# ── Setup wizard and master key (docs/self-hosting/setup/modes-and-keys.md) ──────────────────────
# Master key ring: everything the CMS encrypts (config.enc, secrets stored in the database, storage
# link signing) is protected by keys derived from it. Format kid:base64 of exactly 32 bytes, comma
# separated; the first key encrypts, all of them decrypt (rotation). Example key:
# `node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"`.
# Unset: the first boot creates <POLYNOVEA_CONFIG_DIR>/master.key and the wizard shows it once.
# Required on hosts without a writable disk. Keep a copy away from the database backups.
CMS_MASTER_KEY=
# Where config.enc (the wizard's database settings, encrypted) and master.key live. Owned by the
# user the CMS runs as (never root), folder 0700, files 0600. Default: /var/lib/polynovea.
POLYNOVEA_CONFIG_DIR=
# Automated deploys only: a setup code you choose instead of the one printed to the log. At least
# 128 bits of randomness, e.g. `openssl rand -hex 16`. Read once at start-up, stored hashed and then
# deleted from the process environment.
POLYNOVEA_SETUP_CODE=
# Operator only: extra database hostnames or CIDR ranges the wizard may connect to on a private
# network (managed RDS and Azure hostnames are allowed already), comma separated. Never set from the UI.
POLYNOVEA_SETUP_DB_ALLOWLIST=
# "Created for you" installs: where the cloud template stored the database credentials, an AWS
# Secrets Manager ARN or an Azure Key Vault secret URI. The VM's own identity reads it.
POLYNOVEA_DB_SECRET_REF=

# LEGACY. The old single key for secrets stored in the database. While CMS_MASTER_KEY is unset it
# serves as the master key (key ID "legacy") and no master.key is created, so existing installs and
# multi-server setups keep working unchanged. After setting CMS_MASTER_KEY, keep this set until
# `npm run cms -- keys reencrypt` has moved every value. Storage links signed with it keep verifying
# while it is set.
CMS_CONFIG_ENCRYPTION_KEY=

# Optional delivery signing fallback
CMS_DELIVERY_SIGNING_SECRET=

# Optional website revalidation integration
WEBSITE_URL=
WEBSITE_REVALIDATE_SECRET=

# Optional Cloudflare R2 / S3-compatible media reference adapter
R2_ACCOUNT_ID=
R2_S3_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=media
R2_PUBLIC_URL=

# Public URL of this CMS (e.g. https://cms.example.com). Media inserted into content is stored as a
# permanent CMS media link (/api/storage/media/...) unless the bucket has a public/CDN URL, so this
# must be the address the public website can reach. Unset: links are relative to the CMS origin.
POLYNOVEA_PUBLIC_URL=

# Media on this server's disk: storage.local connections, and the default when a workspace has no storage
# connection and the R2_* variables are not all set. Include this directory in backups.
# Default: /var/lib/polynovea/storage. Uploads are refused when they would leave less than
# POLYNOVEA_STORAGE_MIN_FREE_BYTES free (default 1 GiB; the database may share the disk).
POLYNOVEA_STORAGE_DIR=
POLYNOVEA_STORAGE_MIN_FREE_BYTES=
# Signs CMS file and upload links (local disk, Azure Blob uploads): base64 of 32+ random bytes,
# e.g. `openssl rand -base64 32`. Comma-separated = key ring (first signs, all verify) for rotation.
# Unset: derived from the master key ring (CMS_MASTER_KEY or master.key). Azure Blob itself uses the VM's managed identity
# and needs no variable here; see docs/self-hosting/STORAGE.md.
POLYNOVEA_STORAGE_SIGNING_KEY=

# Optional per-workspace media storage quota in bytes (live registered assets). Unset = no quota.
# Example: 5368709120 for 5 GiB. Single files are capped at 10 MB (images) and 200 MB (video).
MEDIA_WORKSPACE_QUOTA_BYTES=

# Optional Google Analytics 4 integration
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# Optional CLI / MCP client defaults
POLYNOVEA_CMS_URL=http://localhost:3000
POLYNOVEA_CMS_TOKEN=

# Optional first-admin bootstrap defaults. Prefer passing --email explicitly.
POLYNOVEA_BOOTSTRAP_ADMIN_EMAIL=
POLYNOVEA_BOOTSTRAP_ADMIN_USERNAME=
POLYNOVEA_BOOTSTRAP_ADMIN_DISPLAY_NAME=
POLYNOVEA_DEFAULT_WORKSPACE_SLUG=polynovea

# Optional schema engine caps (defaults: 200 models, 150 fields and 50 indexed fields per model).
# PostgreSQL allows 1,600 columns per table and counts deleted fields too; a model table that reaches
# that limit needs a rebuild before more fields can be added, whatever these caps say.
# POLYNOVEA_SCHEMA_MAX_MODELS=200
# POLYNOVEA_SCHEMA_MAX_FIELDS_PER_MODEL=150
# POLYNOVEA_SCHEMA_MAX_INDEXES_PER_MODEL=50

{
  "name": "polynovea-nextjs-site-example",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run sdk:build && npm run types:check",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "sdk:build": "npm --prefix ../../packages/cms-sdk run build",
    "types:check": "node scripts/check-types.mjs",
    "types:pull": "node ../../packages/cms-cli/bin/polynovea-cms.mjs types pull --out polynovea-cms.ts"
  },
  "dependencies": {
    "@polynovea/cms-sdk": "file:../../packages/cms-sdk",
    "next": "^15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "0.35.5",
    "source-map-js": "^1.2.2"
  }
}

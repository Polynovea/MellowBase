[Unit]
Description=Polynovea CMS: show the one-time setup code on the serial console while in setup mode
After=systemd-journald.service docker.service
Before=polynovea.service

[Service]
Type=simple
# Only the setup-code line, only while /api/health says "setup" (console-code.sh). Reads only entries
# journald itself attributes to dockerd (_SYSTEMD_UNIT is a trusted field no other process can set)
# for the container named polynovea; SYSLOG_IDENTIFIER could be forged by any local `logger`.
ExecStart=/bin/sh -c 'journalctl --follow --lines=0 --output=cat _SYSTEMD_UNIT=docker.service CONTAINER_NAME=polynovea | /opt/polynovea/console-code.sh'
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
